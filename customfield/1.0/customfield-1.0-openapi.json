        "operationId": "getAttributeGroupCodeData",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Group/getAttributeGroupCodeData/getAttributeGroupCodeData-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "grouping_code": "30001",
                    "domain_entity_type": "CUSTOMER",
                    "domain_entity_id": "10000000215"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Group/getAttributeGroupCodeData/getAttributeGroupCodeData-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "domain_entity_id": "10000000215",
                      "grouping_code": "CUSTOMER_PREFS",
                      "grouping_code_id": "30001",
                      "grouping_code_desc": "Customer Preferences",
                      "group_list": [
                        {
                          "sequence": "2",
                          "field_list": [
                            {
                              "sequence": "1",
                              "param_data": null,
                              "field_value": null,
                              "field_name": "Newsletter Opt-in",
                              "field_id": "NEWSLETTER_OPT_IN"
                            }
                          ],
                          "group_id": "PREFERENCES",
                          "group_name": "Preferences"
                        }
                      ],
                      "domain_entity_type": "CUSTOMER",
                      "response_code": "S200",
                      "response_ref_id": "235157",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
