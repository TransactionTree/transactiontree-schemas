        "operationId": "createGroup",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Group/createGroup/createGroup-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "group_id": "MY_GROUP",
                    "group_name": "My Group",
                    "sequence": "1",
                    "hide": "N"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Group/createGroup/createGroup-response.schema.json"
