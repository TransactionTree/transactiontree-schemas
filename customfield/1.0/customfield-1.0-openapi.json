{
  "openapi": "3.0.3",
  "info": {
    "title": "Customer Custom Fields API",
    "version": "1.0.0",
    "description": "Read and write custom-field (attribute) values on a customer, and manage the field/group definitions behind them. Part of the C360 platform; distinct from the C360 3.0 XML (XmlInput) API. All operations are POST with a JSON body; every reply is HTTP 200 carrying a response_code envelope (branch on response_code, never HTTP status). See README.md for the auth model, error table and the two storage families. Request/response JSON Schemas live beside each operation."
  },
  "servers": [
    {
      "url": "{C360BaseURL}/customfield-app/api/attribute",
      "variables": {
        "C360BaseURL": {
          "default": "https://c360.sandbox.example.com",
          "description": "Your C360 base URL; real hosts are issued with credentials."
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <token>, where token = base64(secretCode). secretCode is issued with your credentials. Some read endpoints currently do not enforce the token."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Customer",
      "description": "A customer's attribute values."
    },
    {
      "name": "Group",
      "description": "Attribute group definitions and per-customer group reads."
    },
    {
      "name": "Field",
      "description": "Attribute field definitions."
    }
  ],
  "paths": {
    "/customer/v1/searchCustomerField": {
      "post": {
        "tags": [
          "Customer"
        ],
        "summary": "Read a customer's attribute values for one group type.",
        "description": "Returns the customer's stored values for the given groupType. Reads the classification store. For a SEGMENTATION groupType the returned customFieldId values are the segment memberships themselves. Errors: E145 (externalId unmatched), E135 (customer not found/inactive), E152 (groupType missing), E153 (groupType invalid), E1020 (bad email), E1039 (phone < 10 digits).",
        "operationId": "searchCustomerField",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Customer/searchCustomerField/searchCustomerField-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "customerIdentifier": {
                      "partyId": "10000000215"
                    },
                    "groupType": "CUSTOM_FIELD"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Customer/searchCustomerField/searchCustomerField-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "email": "jane.doe@example.com",
                      "customerId": "10000000215",
                      "customFields": [
                        {
                          "customFieldId": "LOYALTY_TIER",
                          "customFieldName": "Loyalty Tier",
                          "value": "GOLD"
                        }
                      ],
                      "phone": "5555550100",
                      "response_code": "S200",
                      "response_ref_id": "235133",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
    "/customer/v1/updateCustomerField": {
      "post": {
        "tags": [
          "Customer"
        ],
        "summary": "Set one or more attribute values on a customer.",
        "description": "Writes the classification store. Each customFields entry needs a customFieldId that already exists (create it first via createField) and a value. The reply echoes updatedFields with oldValue/newValue. QUIRK: an unknown customFieldId does NOT return an E### code \u2014 response_code comes back as the free-text '<id> is Invalid, ' with empty response_code_desc and null updatedFields; detect success by a leading 'S'. Errors: E135 (customer not found), E151 (customFields empty).",
        "operationId": "updateCustomerField",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Customer/updateCustomerField/updateCustomerField-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "customerIdentifier": {
                      "partyId": "10000000215"
                    },
                    "customFields": [
                      {
                        "customFieldId": "LOYALTY_TIER",
                        "value": "GOLD"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Customer/updateCustomerField/updateCustomerField-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "customerId": "10000000215",
                      "updatedFields": [
                        {
                          "customFieldId": "LOYALTY_TIER",
                          "oldValue": "",
                          "newValue": "GOLD"
                        }
                      ],
                      "response_code": "S200",
                      "response_ref_id": "235150",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
    "/group/v1/searchGroup": {
      "post": {
        "tags": [
          "Group"
        ],
        "summary": "List every group of a type with its fields (definitions only).",
        "description": "Definition data only \u2014 no customer values. Errors: E152 (groupType missing), E153 (invalid).",
