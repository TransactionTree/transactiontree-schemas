    "/field/v1/createField": {
      "post": {
        "tags": [
          "Field"
        ],
        "summary": "Create a field (attribute) definition.",
        "description": "snake_case body. custom_field_name and custom_field_type required; custom_field_format must be a FieldFormat value; hide is 'Y'/'N'. KNOWN ISSUE: the current build's type validation is inverted \u2014 it rejects the intended values 'SINGLE'/'MULTIPLE' with E1004 and accepts other strings. Until fixed, create fields in the admin UI rather than via this endpoint. Errors: E1006 (missing), E1004 (format not in vocabulary), E1001 (unknown group_id).",
        "operationId": "createField",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Field/createField/createField-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "custom_field_id": "MY_FIELD",
                    "group_id": "MY_GROUP",
                    "custom_field_name": "My Field",
                    "custom_field_type": "SINGLE",
                    "custom_field_format": "TEXT",
                    "custom_field_length": "40",
                    "sequence_number": "1",
                    "hide": "N"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Field/createField/createField-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "custom_field_id": "MY_FIELD",
                      "response_code": "S200",
                      "response_ref_id": "235144",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
