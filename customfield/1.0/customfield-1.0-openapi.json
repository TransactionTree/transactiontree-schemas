              "schema": {
                "$ref": "Group/searchGroup/searchGroup-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "groupType": "CUSTOM_FIELD"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Group/searchGroup/searchGroup-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "groups": [
                        {
                          "groupId": "LOYALTY",
                          "groupName": "Loyalty",
                          "groupType": "CUSTOM_FIELD",
                          "customFields": [
                            {
                              "customFieldId": "LOYALTY_TIER",
                              "customFieldName": "Loyalty Tier",
                              "isEnabled": ""
                            }
                          ]
                        }
                      ],
                      "response_code": "S200",
                      "response_ref_id": "235140",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
    "/group/v1/searchGroupField": {
      "post": {
        "tags": [
          "Group"
        ],
        "summary": "List the field definitions in one group.",
        "description": "Return the field definitions in a group by groupId. Gives type and length but NOT the permitted option values. There is no list-all endpoint; you must know the groupId. Errors: E154 (groupId missing), E155 (unknown groupId).",
        "operationId": "searchGroupField",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Group/searchGroupField/searchGroupField-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "groupId": "LOYALTY"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Group/searchGroupField/searchGroupField-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "groupName": "Loyalty",
                      "groupId": "LOYALTY",
                      "customFields": [
                        {
                          "customFieldId": "LOYALTY_TIER",
                          "customFieldName": "Loyalty Tier",
                          "isEnabled": "",
                          "customFieldLength": "40",
                          "customFieldType": "SINGLE"
                        }
                      ],
                      "groupType": "CUSTOM_FIELD",
                      "response_code": "S200",
                      "response_ref_id": "235146",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
    "/group/v1/getAttributeGroupData": {
      "post": {
        "tags": [
          "Group"
        ],
        "summary": "Read a group's field values for one customer.",
        "description": "Read the field values of one group for one domain entity. Reads the field-value store (note: a value written via updateCustomerField lands in the classification store and will NOT appear here \u2014 read it back via searchCustomerField). Returns a 'group' object whose field_list carries field_value (null when unset); 'group' is null when the entity has no row for the group. snake_case body. Errors: E1006 (required param missing), E1001 (unknown group_id or entity).",
        "operationId": "getAttributeGroupData",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "Group/getAttributeGroupData/getAttributeGroupData-request.schema.json"
              },
              "examples": {
                "sample": {
                  "value": {
                    "group_id": "PREFERENCES",
                    "domain_entity_type": "CUSTOMER",
                    "domain_entity_id": "10000000215"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200 with the response envelope; branch on response_code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "Group/getAttributeGroupData/getAttributeGroupData-response.schema.json"
                },
                "examples": {
                  "success": {
                    "value": {
                      "domain_entity_id": "10000000215",
                      "grouping_code": "CUSTOMER_PREFS",
                      "grouping_code_id": "30001",
                      "grouping_code_desc": "Customer Preferences",
                      "domain_entity_type": "CUSTOMER",
                      "group": {
                        "sequence": "2",
                        "field_list": [
                          {
                            "sequence": "1",
                            "param_data": null,
                            "field_value": null,
                            "field_name": "Newsletter Opt-in",
                            "field_id": "NEWSLETTER_OPT_IN"
                          }
                        ],
                        "group_id": "PREFERENCES",
                        "group_name": "Preferences"
                      },
                      "response_code": "S200",
                      "response_ref_id": "235156",
                      "response_code_desc": "[S200] Processed Request Successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Returned only when the JSON body is malformed or empty (rejected before the application runs)."
          }
        }
      }
    },
