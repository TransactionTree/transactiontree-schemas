												<xs:documentation>Addl Long Description of the Product based on the Content Type in ERP or Different Locale</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="L2DESCRIPTION3" type="xs:string" minOccurs="0" maxOccurs="1">
											<xs:annotation>
												<xs:documentation>Addl Long Description of the Product based on the Content Type in ERP or Different Locale</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="L2DESCRIPTION4" type="xs:string" minOccurs="0" maxOccurs="1">
											<xs:annotation>
												<xs:documentation>Addl Long Description of the Product based on the Content Type in ERP or Different Locale</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="L2DESCRIPTION5" type="xs:string" minOccurs="0" maxOccurs="1">
											<xs:annotation>
												<xs:documentation>Addl Long Description of the Product based on the Content Type in ERP or Different Locale</xs:documentation>
											</xs:annotation>
