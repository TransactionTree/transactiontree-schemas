<!-- No targetNamespace: real product-update requests are plain <REQUEST> (no xmlns),
     referenced via xsi:noNamespaceSchemaLocation like the rest of the C360 schema family.
     The legacy copies declared a targetNamespace (and disagreed on its spelling), which
     would have rejected the actual no-namespace instances; removed for correctness and
     family consistency. Consolidated from the two byte-identical legacy copies
     (bormc v2.1.1 + vrg/product v1.0.1); the live server does not validate against the
     namespace (verified 2026-08-15). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.1.1" xml:lang="en">
	<xs:element name="REQUEST">
		<xs:annotation>
			<xs:documentation>XML used to update products in BORMC</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
			<!-- TransactionTree Product Update version Current Version 2.1.1 02/25/2021 -->
				<xs:element name="PRODUCTS">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="PRODUCT" minOccurs="1" maxOccurs="20">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="PRODUCTID" minOccurs="1" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>PRODUCT IDENTIFIER (ALPHANUMERIC)</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="20"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="PRODUCTNAME" minOccurs="1" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>Product Name for Title Display</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="DESCRIPTION1" minOccurs="0" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>Product Description of the Product  (english)</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="DESCRIPTION2" minOccurs="0" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>Additional Descriptions of the Product (diff Locale) or Content type</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="DESCRIPTION3" minOccurs="0" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>Additional Descriptions of the Product (diff Locale) or Content type</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="DESCRIPTION4" minOccurs="0" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>Additional Descriptions of the Product (diff Locale) or Content type</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="DESCRIPTION5" minOccurs="0" maxOccurs="1">
											<xs:simpleType>
												<xs:annotation>
													<xs:documentation>Additional Descriptions of the Product (diff Locale) or Content type</xs:documentation>
												</xs:annotation>
												<xs:restriction base="xs:string">
													<xs:maxLength value="255"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="L2DESCRIPTION1" type="xs:string" minOccurs="0" maxOccurs="1">
