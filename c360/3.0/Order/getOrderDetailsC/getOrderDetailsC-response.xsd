					<xs:documentation>Long token.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_TOKEN" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Token.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
