<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:annotation>
		<xs:documentation>Annotated schema for getOrderDetailsC RESPONSE. Content models are unordered, repeat-tolerant choices ON PURPOSE (2026-10): the production emitter varies element order by tenant and re-emits some elements, so strict sequences reject real responses. Consumers take the first occurrence of a repeated element.</xs:documentation>
	</xs:annotation>
	<xs:simpleType name="EmptyString">
		<xs:annotation>
			<xs:documentation>Represents an intentionally empty value.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value=""/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Money">
		<xs:annotation>
			<xs:documentation>Monetary/quantity decimal that also accepts empty string.</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="xs:decimal EmptyString"/>
	</xs:simpleType>
	<xs:simpleType name="ResponseCode">
		<xs:annotation>
			<xs:documentation>Documented catalog of response codes. NOT binding since 2026-10: RESPONSE_CODE is xs:string so new production codes cannot break validation (a closed enumeration previously hid E300 for years).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="E101">
				<xs:annotation>
					<xs:documentation>XML Input is empty</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E102">
				<xs:annotation>
					<xs:documentation>XML SAX Exception</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E103">
				<xs:annotation>
					<xs:documentation>XML Parse Conf Exception</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E104">
				<xs:annotation>
					<xs:documentation>XML IOException</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E111">
				<xs:annotation>
					<xs:documentation>Person Not Found</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E122">
				<xs:annotation>
					<xs:documentation>From Date / Thru Date Parse Exception</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E124">
				<xs:annotation>
					<xs:documentation>Order Status exceeds 30 Characters</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E126">
				<xs:annotation>
					<xs:documentation>No order found</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E127">
				<xs:annotation>
					<xs:documentation>Invalid or Store tag is blank</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E129">
				<xs:annotation>
					<xs:documentation>No order found</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E899">
				<xs:annotation>
					<xs:documentation>accessTokenKey is not valid</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="E110"><xs:annotation><xs:documentation>Required identifier missing on this operation.</xs:documentation></xs:annotation></xs:enumeration>
			<xs:enumeration value="E300"><xs:annotation><xs:documentation>PRODUCT_ID not found in the tenant product catalog (observed in production; dominant failure on PAL until the 2026-10 catalog backfill).</xs:documentation></xs:annotation></xs:enumeration>
			<xs:enumeration value="E888"><xs:annotation><xs:documentation>Unknown X-tenant-Key header (gate level; arrives wrapped in WEBSERVICE).</xs:documentation></xs:annotation></xs:enumeration>
			<xs:enumeration value="E999"><xs:annotation><xs:documentation>Unhandled exception; RESPONSE_MESSAGE carries detail.</xs:documentation></xs:annotation></xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="TaxType">
		<xs:annotation>
			<xs:documentation>Tax line; fields are order-insensitive and optional.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="TAX_TYPE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tax classification (e.g., StateOrProvince).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_AMOUNT" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tax amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_PERCENTAGE" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Rate as decimal (or empty).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_DESCRIPTION" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tax description (e.g., GST/PST).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_AUTHORITY" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Jurisdiction (e.g., FED).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_RULE_CODE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Rule code.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAXABLE_AMOUNT" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Taxable base.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_VOIDED" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voided flag (Y/N).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_VOIDED_LINE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voiding line ref.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_START_DATE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Start date string.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_DETAIL_NUMBER" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tax detail id.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_DETAIL_NUMBER_VOIDED" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voided detail id.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_NUMBER" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tax number.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_VALUE_EXEMPT" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Exempt value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_AMOUNT_EXEMPT" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Exempted amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_AMOUNT_TAXABLE" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Taxable amount part.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_LINE_VOIDED" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tax line voided flag.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TAX_LINE_VOIDING_LINE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voiding line ref.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="CrossReferenceType">
		<xs:annotation>
			<xs:documentation>Customer cross-reference entry.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="SYSTEM_REFERENCE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>System/type key (LO...Y_ID, POS_ID, ATG_CUST_ID, PRETAIL_ID, etc.).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SYSTEM_REFERENCE_ID" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Value in that system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="AttributeType">
		<xs:annotation>
			<xs:documentation>Generic attribute triplet.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="ATTRIBUTE_TYPE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Key/type name.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ATTRIBUTE_DESCRIPTION" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human description.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ATTRIBUTE_DATA" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="DiscountType">
		<xs:annotation>
			<xs:documentation>A single discount applied to an item.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="DISCOUNT_PERCENT" type="Money" minOccurs="0">
