					<xs:documentation>Percent as decimal (or empty).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_AMOUNT" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Absolute discount amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_DESCRIPTION" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Description.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_CODE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Code id.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_CODETYPE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Code type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_METHOD" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Method.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_RATE" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Rate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRINT_LINE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Printed description line.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AMOUNT_DISCOUNTABLE" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Eligible amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_PROMO_CODE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Promo code.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_VOIDED" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voided flag (Y/N).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DISCOUNT_VOIDED_LINE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voiding line ref.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="BarCodeType">
		<xs:annotation>
			<xs:documentation>Barcode block.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="BarCodeFlag" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Boolean-like string true/false.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BarCodeType" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Symbology.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BarCodeValue" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Encoded value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
	</xs:complexType>
	<xs:complexType name="TenderItemType">
		<xs:annotation>
			<xs:documentation>Payment/tender line at header level.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="TENDER_ITEM_NAME" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tender label.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_ITEM_VALUE" type="Money" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_CARD_NAME" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Card brand.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AUTHORIZATION_CODE" type="xs:string" minOccurs="0">
