					<xs:documentation>Auth code.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_ITEM_ACCOUNT" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Masked account.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_AMOUNT_FOREIGN" type="Money" minOccurs="0">
