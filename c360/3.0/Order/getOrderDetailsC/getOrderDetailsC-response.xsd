					<xs:documentation>Foreign amount.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_MEDIA_TYPE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Media type.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_VOIDED" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Voided flag.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TENDER_VOIDING_LINE" type="xs:string" minOccurs="0">
