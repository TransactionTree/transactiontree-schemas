			<xs:element name="LEVEL_5_LEVEL_5_ID" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Hierarchy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LEVEL_5_PRODUCT_GROUP_TYPE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Hierarchy.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LEVEL_5_STRUCTURE_TYPE" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Hierarchy.</xs:documentation>
