<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation>
      REQUEST schema for getOrderDetailsC. The XML is carried in the form field 'XmlInput'.
      Verified against the loyalty-app service generation, 2026-10.

      Relationship to getOrderDetailsB
      --------------------------------
      getOrderDetailsC and getOrderDetailsB are served by the SAME implementation and return the
      SAME response. The single behavioural difference: getOrderDetailsB REQUIRES CUSTOMER_ID
      (E110 when it is missing or empty); getOrderDetailsC does not. This is the operation new
      integrations should use.

      How the service reads the request
      ---------------------------------
      Elements are direct children of the root (the root name itself is not checked), are matched
      by local name case-insensitively, may appear in any order, and unknown elements are ignored.
      The service does not validate against this schema.

      Order of checks (first failure wins)
      ------------------------------------
      E101-E104 (XmlInput missing / unparseable), E131 / E132 / E134 (tender token not found),
      E122 (FROM_DATE / THRU_DATE not parseable), [LayAway branch - see TRANSACTION_TYPE],
      E127 (STORE_ID missing or unknown), E124 (ORDER_STATUS longer than 30 characters),
      E111 (CUSTOMER_ID supplied but unknown), E126 (no order matched).
      All supplied filters are combined with logical AND. (Deployments still reading from the
      legacy order-header data source apply only the customer, status, date-range and tender-token
      filters; ORDER_ID, REGISTER_NUMBER and PRODUCTS are not applied there.)
    </xs:documentation>
  </xs:annotation>
  <xs:element name="REQUEST">
    <xs:annotation>
      <xs:documentation>Request for getOrderDetailsC: filters used to locate one or more orders and return their full line-item, tender and tax detail.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element name="CUSTOMER_ID" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional on getOrderDetailsC. Customer identifier; when supplied, restricts the search to orders billed to this customer. Supplied but not a known customer: E111.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="STORE_ID" type="xs:string">
          <xs:annotation>
            <xs:documentation>REQUIRED. Store the order took place at. Missing, empty or unknown: E127. Leading-zero variants of the store number are treated as the same store. (Exception: optional on the LayAway branch.)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ORDER_ID" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. POS transaction / receipt number of the order. Matched against the order's external transaction number, tolerating leading-zero padding differences. When omitted, all orders matching the other filters are returned (up to RECORD_LIMIT).</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="REGISTER_NUMBER" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Register / till number; leading-zero padding differences are tolerated.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="FROM_DATE" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Lower bound (inclusive, start of day) on the order date, format yyyy-MM-dd. Default when omitted: 2000-01-01. Unparseable value: E122.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="THRU_DATE" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Upper bound (inclusive, end of day) on the order date, format yyyy-MM-dd. Default when omitted: today. Unparseable value: E122.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ORDER_STATUS" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Order status filter, supplied WITHOUT a status prefix (e.g. COMPLETED, APPROVED, CREATED, REJECTED); the service adds the prefix used by the deployment's transaction data source. Longer than 30 characters: E124. When omitted, orders in the approved / created / completed / rejected states are returned.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="RECORD_LIMIT" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Maximum number of orders to return, integer text. Default 25; values above 100 are reduced to 100. A non-numeric value is ignored (default applies) unless diagnostics are enabled for the deployment, in which case it returns E1006.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="PRODUCTS" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Restricts the result to orders containing at least one of the listed products.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="PRODUCT_ID" type="xs:string" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>SKU number or external SKU identifier. Repeat for several products (logical OR between them).</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="TENDER_SHORTTOKEN" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Find orders paid with the tender carrying this short token. No payment with this token: E131.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TENDER_LONGTOKEN" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Find orders paid with the tender carrying this long token. No payment with this token: E132.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TENDER_TOKEN" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Find orders paid with the tender carrying this token. No payment with this token: E134.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TRANSACTION_TYPE" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. The only value acted on is "LayAway" (case-insensitive), which switches the call to the layaway branch: layaway transactions are searched by ORDER_ID, CUSTOMER_ID, STORE_ID, REGISTER_NUMBER, LAYAWAY_NUMBER and the date range (all optional there), and the reply is NOT the RESPONSE envelope but a Transactions document holding the stored layaway payloads (see the getOrderDetailsC layaway response schema); E126 in the normal envelope when nothing matches. Any other value is ignored.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="LAYAWAY_NUMBER" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Layaway number, exact match; only used on the LayAway branch.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SYSTEM_REFERENCE" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. External-system identifier type (e.g. POS_ID, LOYALTY_ID). Together with SYSTEM_REFERENCE_ID it identifies the customer when CUSTOMER_ID is absent; when CUSTOMER_ID is supplied the pair is ignored.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SYSTEM_REFERENCE_ID" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Identifier value for SYSTEM_REFERENCE (see SYSTEM_REFERENCE).</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="REQUEST_DATE" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Optional. Client timestamp; read but not used by the service (free text).</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
