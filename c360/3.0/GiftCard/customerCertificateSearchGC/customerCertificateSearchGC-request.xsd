<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation>REQUEST schema for customerCertificateSearchGC (Customer360). This XML is carried in the form field 'XmlInput'.</xs:documentation>
  </xs:annotation>
  <xs:element name="REQUEST">
    <xs:annotation>
      <xs:documentation>Request payload used to search a customer's gift-card certificates.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <!-- NOTE (verbatim from legacy contract; not renamed — external integrators may depend on it): criteria (lowercase wrapper) -->
        <xs:element name="criteria">
          <xs:annotation>
            <xs:documentation>Search criteria container for the gift-card certificate search.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="REQUEST_DATE" type="xs:dateTime">
                <xs:annotation>
                  <xs:documentation>The date and time of this request. ISO 8601. Example: 2025-11-01T18:05:00Z.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="CUSTOMER_ID" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Customer identifier whose gift-card certificates are being searched.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="STORE_ID" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Store identifier providing context for the search.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="RECORD_LIMIT" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Maximum number of records to return. Defaults to 25 when omitted or invalid.</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
