<?xml version="1.0" encoding="UTF-8"?>
<!-- Fully populated request: every element the schema allows, with realistic synthetic values.
     REQ_REWARD_POINTS and EV_BALANCE are ignored by the service (output-only values tolerated for round-trips).
     LOYALTY_ID as a direct child of CUSTOMER only matters when a new customer is created; the loyalty
     identifier itself travels as a CROSS_REFERENCE. -->
<REQUEST>
  <CUSTOMER>
    <CUSTOMER_ID>1234567</CUSTOMER_ID>
    <FIRST_NAME>JANE</FIRST_NAME>
    <LAST_NAME>SAMPLE</LAST_NAME>
    <GENDER>FEMALE</GENDER>
    <BIRTHDAY>1990-05-17</BIRTHDAY>
    <ASSIGNED_STORE>001</ASSIGNED_STORE>
    <LOYALTY_STORE>001</LOYALTY_STORE>
    <PREFERRED_STORE>002</PREFERRED_STORE>
    <STORE_ID>001</STORE_ID>
    <LOYALTY_ID>00123456</LOYALTY_ID>
    <MKT_SEGMENT>SEGMENT_A</MKT_SEGMENT>
    <CASHIER>1001</CASHIER>
    <REQ_REWARD_POINTS>35</REQ_REWARD_POINTS>
    <EV_BALANCE>40</EV_BALANCE>
    <CUSTOMER_CROSS_REFERENCES>
      <CROSS_REFERENCE>
        <SYSTEM_REFERENCE>POS_ID</SYSTEM_REFERENCE>
        <SYSTEM_REFERENCE_ID>7654321</SYSTEM_REFERENCE_ID>
      </CROSS_REFERENCE>
      <CROSS_REFERENCE>
        <SYSTEM_REFERENCE>LOYALTY_ID</SYSTEM_REFERENCE>
        <SYSTEM_REFERENCE_ID>00123456</SYSTEM_REFERENCE_ID>
      </CROSS_REFERENCE>
    </CUSTOMER_CROSS_REFERENCES>
    <POSTAL_CONTACTS>
      <CONTACT>
        <CONTACT_MECH_ID>2000001</CONTACT_MECH_ID>
        <TO_NAME>JANE SAMPLE</TO_NAME>
        <ADDRESS1>100 EXAMPLE STREET</ADDRESS1>
        <ADDRESS2>UNIT 1</ADDRESS2>
        <CITY>SPRINGFIELD</CITY>
        <STATE>XX</STATE>
        <ZIPCODE>00000</ZIPCODE>
        <ZIP4>0000</ZIP4>
        <COUNTRY>USA</COUNTRY>
        <CONTACT_TYPE>PRIMARY_LOCATION</CONTACT_TYPE>
        <ALLOW_SOLICITATION>Y</ALLOW_SOLICITATION>
        <DELIVERABLE>Y</DELIVERABLE>
        <EXPIRE>N</EXPIRE>
        <CUSTOMER_MECH_REFERENCES>
          <CROSS_REFERENCE>
            <SYSTEM_REFERENCE>LEGACY_ID</SYSTEM_REFERENCE>
            <SYSTEM_REFERENCE_ID>ADDR-0001</SYSTEM_REFERENCE_ID>
          </CROSS_REFERENCE>
        </CUSTOMER_MECH_REFERENCES>
      </CONTACT>
    </POSTAL_CONTACTS>
    <EMAIL_CONTACTS>
      <CONTACT>
        <CONTACT_MECH_ID>2000002</CONTACT_MECH_ID>
        <EMAIL>jane.sample@example.com</EMAIL>
        <CONTACT_TYPE>PRIMARY_EMAIL</CONTACT_TYPE>
        <ALLOW_SOLICITATION>Y</ALLOW_SOLICITATION>
        <EMAIL_DELIVERABLE_FLAG>Y</EMAIL_DELIVERABLE_FLAG>
        <EXPIRE>N</EXPIRE>
        <CUSTOMER_MECH_REFERENCES>
          <CROSS_REFERENCE>
            <SYSTEM_REFERENCE>LEGACY_ID</SYSTEM_REFERENCE>
            <SYSTEM_REFERENCE_ID>EMAIL-0001</SYSTEM_REFERENCE_ID>
          </CROSS_REFERENCE>
        </CUSTOMER_MECH_REFERENCES>
      </CONTACT>
    </EMAIL_CONTACTS>
    <PHONE_CONTACTS>
      <CONTACT>
        <CONTACT_MECH_ID>2000003</CONTACT_MECH_ID>
        <PHONE>5555550100</PHONE>
        <CONTACT_TYPE>PRIMARY_PHONE</CONTACT_TYPE>
        <ALLOW_SOLICITATION>N</ALLOW_SOLICITATION>
        <EXPIRE>N</EXPIRE>
        <CUSTOMER_MECH_REFERENCES>
          <CROSS_REFERENCE>
            <SYSTEM_REFERENCE>LEGACY_ID</SYSTEM_REFERENCE>
            <SYSTEM_REFERENCE_ID>PHONE-0001</SYSTEM_REFERENCE_ID>
          </CROSS_REFERENCE>
        </CUSTOMER_MECH_REFERENCES>
      </CONTACT>
    </PHONE_CONTACTS>
  </CUSTOMER>
</REQUEST>
